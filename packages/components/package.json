{
  "name": "@teamnovu/kit-components",
  "version": "1.2.3",
  "description": "A collection of vue(3) components for jkweb",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Image": {
      "types": "./dist/Image.vue.d.ts",
      "import": "./dist/Image.js"
    },
    "./Dialog": {
      "types": "./dist/Dialog.vue.d.ts",
      "import": "./dist/Dialog.js"
    },
    "./Collapse": {
      "types": "./dist/Collapse.vue.d.ts",
      "import": "./dist/Collapse.js"
    },
    "./Accordion": {
      "types": "./dist/accordion/Accordion.vue.d.ts",
      "import": "./dist/Accordion.js"
    },
    "./AccordionItem": {
      "types": "./dist/accordion/AccordionItem.vue.d.ts",
      "import": "./dist/AccordionItem.js"
    },
    "./AccordionHeader": {
      "types": "./dist/accordion/AccordionHeader.vue.d.ts",
      "import": "./dist/AccordionHeader.js"
    },
    "./AccordionBody": {
      "types": "./dist/accordion/AccordionBody.vue.d.ts",
      "import": "./dist/AccordionBody.js"
    },
    "./HAccordion": {
      "types": "./dist/accordion/HAccordion.vue.d.ts",
      "import": "./dist/HAccordion.js"
    },
    "./HAccordionItem": {
      "types": "./dist/accordion/HAccordionItem.vue.d.ts",
      "import": "./dist/HAccordionItem.js"
    },
    "./AccessibleComponent": {
      "types": "./dist/AccessibleComponent.vue.d.ts",
      "import": "./dist/AccessibleComponent.js"
    }
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "build": "vite build",
    "watch": "NODE_ENV=development vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:teamnovu/kit.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "components"
  ],
  "author": "Elias Bernhaut",
  "homepage": "https://kit.novu.ch/packages/components/",
  "dependencies": {
    "@teamnovu/kit-composables": "workspace:*",
    "@vueuse/core": "^15.0.0",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "vitest": "^5.1.0"
  }
}
